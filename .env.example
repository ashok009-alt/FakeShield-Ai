# ---------------------------------------------------------------------------
# FakeShield AI environment. Every key is optional except DATABASE_URL.
# Secrets belong here (server-side only). Never prefix a secret with
# NEXT_PUBLIC_ — that would ship it to the browser.
# ---------------------------------------------------------------------------

# Local demo database (SQLite). For Neon/PostgreSQL see README "PostgreSQL".
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Optional threat feed for URL checks (Google Cloud -> Safe Browsing API).
GOOGLE_SAFE_BROWSING_API_KEY=""

# Optional Gemini reasoning pass. Without a key the rule engine is used alone
# and the UI says "rules only". Free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Optional URL threat intel. The submitted host is never contacted by FakeShield;
# VirusTotal receives the URL string only.
VIRUSTOTAL_API_KEY=""
IPINFO_TOKEN=""
SHODAN_API_KEY=""

# Optional breach lookup. The sender address is sent to Have I Been Pwned only
# after the user ticks the consent box.
HIBP_API_KEY=""

# Optional Upstash Redis: shared 24h cache + 10 req/min/IP rate limiting.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Optional SMS channel (Twilio). TWILIO_WEBHOOK_URL must be the exact public
# https URL Twilio signs, e.g. https://your-domain/api/channels/twilio
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
TWILIO_WEBHOOK_URL=""

# Optional Telegram bot. The secret is sent back by Telegram on every update.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""

# Optional WhatsApp Business Cloud API webhook.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
WHATSAPP_API_VERSION="v21.0"

# Optional weekly threat-report email (SendGrid free tier).
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL=""
SENDGRID_FROM_NAME="FakeShield AI"
SENDGRID_REPLY_TO=""

# Used in digest unsubscribe links and absolute metadata.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
