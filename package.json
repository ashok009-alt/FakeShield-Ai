{
  "name": "fakeshield-ai",
  "version": "1.0.0",
  "private": true,
  "description": "FakeShield AI - explainable scam detection for messages, emails and links.",
  "scripts": {
    "predev": "prisma db push && tsx prisma/seed.ts",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma db push && tsx prisma/seed.ts",
    "digest:send": "tsx scripts/send-digest.ts",
    "db:postgres": "node scripts/build-postgres-schema.mjs && prisma db push --schema prisma/schema.postgres.prisma",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@radix-ui/react-accordion": "1.3.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tabs": "1.2.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "framer-motion": "12.43.0",
    "jspdf": "^2.5.2",
    "lucide-react": "0.468.0",
    "maplibre-gl": "^5.9.0",
    "next": "15.5.28",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "recharts": "2.15.4",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "topojson-client": "^3.1.0",
    "zod": "3.25.76",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "22.20.5",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.7",
    "prisma": "6.19.3",
    "tailwindcss": "4.1.18",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
